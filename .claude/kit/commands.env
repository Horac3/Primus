# claude-kit check commands for Primus (Go). Sourced by .claude/kit/check.sh.
# golangci-lint is not installed on the dev machine, so lint is go vet plus a gofmt listing.
# Race tests run separately via scripts/race.sh (needs gcc, so it runs in the golang image).
# core.autocrlf=true checks files out as CRLF while the index is LF, so the gofmt check strips CR
# first: it reports what CI would see, not working-tree line endings.
CHECK_TYPECHECK='go build ./...'
CHECK_LINT='go vet ./... && bad="" && for f in $(git ls-files -co --exclude-standard "*.go"); do src="$(tr -d "\r" <"$f")"; [ "$(printf "%s\n" "$src" | gofmt)" = "$src" ] || bad="$bad $f"; done; [ -z "$bad" ] || { echo "gofmt needed:$bad"; exit 1; }'
CHECK_TEST='go test ./... "$@"'
CHECK_TEST_ONE='go test ./... -run "$1"'
CHECK_FORMAT='gofmt -l .'
CHECK_MAX_LINES=60
