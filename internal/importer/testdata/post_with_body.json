{
  "openapi": "3.0.0",
  "info": { "title": "Test", "version": "1.0" },
  "paths": {
    "/pets": {
      "post": {
        "operationId": "createPet",
        "summary": "Create a pet",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name":  { "type": "string" },
                  "age":   { "type": "integer" }
                },
                "example": { "name": "Fido", "age": 3 }
              }
            }
          }
        },
        "responses": { "201": { "description": "created" } }
      }
    }
  }
}
